    "traversal": {
      "entry_pointer": "arg1 points at the first 32-bit head cell; current head is loaded from [arg1]. Cursor starts at arg1+4.",
      "next_bucket": "If current ESI equals cursor, ESI is the address of the next head cell (an empty-bucket sentinel before any primitive, or a tail-link sentinel after the prior primitive was processed). AC60 dereferences that cell for its head, advances cursor by four, and repeats. Otherwise a non-null ESI points to a primitive, which is dispatched; the loop then loads its first DWORD link and repeats the comparison.",
      "termination": "A NULL current head exits. Valid initialized ordering tables terminate within the measured 0x500-DWORD region before a one-past cell read. AC60 has no explicit slot-count bound; malformed tails and out-of-range/corrupt tables remain unresolved."
    },
    "dispatch": {
      "tag_byte_offset": 7,
      "group_mask": "0xe0",
      "normalize": "clear bit 1 (AND 0xfd) for base-code compare; then test original bit 1 separately to select one of two rasterizer paths.",
      "routes": [
        {
          "group": "0x20",
          "base_codes": {
            "0x24": "FT3-compatible field reads; output vertex 2 is duplicated to vertex 3",
            "0x2c": "FT4-compatible field reads",
            "0x3c": "GT4-compatible field reads; per-vertex colors are ignored"
          },
          "rasterizer_bit1_clear": "0xd420",
          "rasterizer_bit1_set": "0xe680",
          "access_minimums": {
            "0x24": "0x1e",
            "0x2c": "0x26",
            "0x3c": "0x32"
          }
        },
        {
          "group": "0x60",
          "base_codes": {
            "0x64": "variable width/height sprite-compatible reads",
            "0x74": "fixed 8x8 sprite-compatible reads",
            "0x7c": "fixed 16x16 sprite-compatible reads"
          },
          "rasterizer_bit1_clear": "0xcab0",
          "rasterizer_bit1_set": "0xc8f0",
          "access_minimums": {
            "0x64": "0x14",
            "0x74": "0x0e",
            "0x7c": "0x0e"
          }
        },
        {
          "group": "0xe0 or 0x00",
          "commands": {
            "0xe1": "read DWORD +4 and update texture/page state",
            "0x01": "pass pointer +0x10 and signed words +0x0c/+0x0e to 0xa8f0",
            "0xf3": "read extents and clamp/update rectangle state"
          },
          "access_minimums": {
            "0xe1": "0x08",
            "0x01": "0x10 direct AC60 packet-read envelope; A8F0 reads 8-byte rectangle at +0x10, making 0x18 total record extent",
            "0xf3": "0x0c"
